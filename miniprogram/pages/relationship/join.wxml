<view class="page">
  <view class="card section">
    <view class="title">加入对方的小世界</view>
    <view class="desc">输入邀请码即可加入。</view>

    <input class="code" value="{{code}}" placeholder="邀请码" maxlength="12" bindinput="onCode" />

    <view class="actions">
      <view class="btn-primary" bindtap="join" hover-class="tap-down" hover-stay-time="80">加入</view>
      <view class="btn-ghost" bindtap="back" hover-class="tap-down" hover-stay-time="80">返回</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
