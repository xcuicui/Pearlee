<view class="page">
  <view class="card section">
    <view class="title">{{copy.title}}</view>
    <view class="desc">{{copy.desc}}</view>

    <input class="code" value="{{code}}" placeholder="{{copy.codePlaceholder}}" maxlength="12" bindinput="onCode" />

    <view class="actions">
      <view class="btn-primary" bindtap="join" hover-class="tap-down" hover-stay-time="80">{{copy.submit}}</view>
      <view class="btn-ghost" bindtap="back" hover-class="tap-down" hover-stay-time="80">{{copy.back}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
