.page{padding:48rpx;background:#FAF9F7;min-height:100vh;box-sizing:border-box}
.section{padding:32rpx 28rpx;border-radius:28rpx;background:rgba(255,255,255,.72)}
.title{font-size:34rpx;font-weight:500;color:rgba(38,35,31,.78)}
.subtitle{margin-top:10rpx;font-size:30rpx;color:rgba(38,35,31,.58)}
.hint{margin-top:10rpx;font-size:24rpx;line-height:1.65;color:rgba(38,35,31,.42)}
.input{width:100%;min-height:420rpx;max-height:900rpx;padding:26rpx 26rpx 18rpx;border-radius:22rpx;background:rgba(255,255,255,.62);border:1rpx solid rgba(38,35,31,.10);font-size:30rpx;line-height:1.75;color:rgba(38,35,31,.74)}
.count{margin-top:10rpx;text-align:right;font-size:22rpx;color:rgba(38,35,31,.35)}
.img-head{margin-top:20rpx;display:flex;align-items:center;justify-content:flex-start}
.img-add{padding:10rpx 14rpx;border-radius:18rpx;background:rgba(95,125,149,.10);font-size:22rpx;color:rgba(38,35,31,.62)}
.img-list{margin-top:14rpx;display:flex;gap:14rpx;flex-wrap:wrap}
.img-item{width:170rpx}
.img{width:170rpx;height:170rpx;border-radius:16rpx;background:rgba(245,247,251,.92)}
.img-remove{margin-top:8rpx;text-align:center;font-size:20rpx;color:rgba(178,74,74,.92)}
.actions{margin-top:22rpx;display:flex}
.btn-primary--disabled{opacity:.45;pointer-events:none}
.err{margin-top:22rpx;color:#b24a4a;font-size:24rpx}
