<view class="page">
  <view class="card section">
    <textarea
      class="input"
      placeholder="写下一句话，让今天被点亮。"
      maxlength="500"
      value="{{text}}"
      bindinput="onText"
      auto-height="true"
    />
    <view class="count">{{text.length}}/500</view>

    <view class="img-head">
      <view class="img-title">图片（{{images.length}}/9）</view>
      <view class="img-add" bindtap="chooseImages" hover-class="tap-down" hover-stay-time="60">添加</view>
    </view>
    <view class="img-list" wx:if="{{images.length}}">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-idx="{{index}}" />
        <view class="img-remove" bindtap="removeImage" data-idx="{{index}}" hover-class="tap-down" hover-stay-time="60">移除</view>
      </view>
    </view>

    <view class="actions">
      <view class="btn-primary" bindtap="publish" hover-class="tap-down" hover-stay-time="80">发布</view>
      <view class="btn-ghost" bindtap="cancel" hover-class="tap-down" hover-stay-time="80">取消</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
