<view class="page">
  <view class="section">
    <view class="title">{{titleText}}</view>
    <view class="subtitle">{{subtitleText}}</view>
    <view class="hint">{{hintText}}</view>

    <textarea
      class="input"
      placeholder="{{placeholderText}}"
      placeholder-style="color: rgba(38,35,31,.36);"
      maxlength="500"
      value="{{text}}"
      bindinput="onText"
      auto-height="true"
      focus="true"
    />

    <view class="count" wx:if="{{showCount}}">{{text.length}}/500</view>

    <view class="img-head">
      <view class="img-add" bindtap="chooseImages" hover-class="tap-down" hover-stay-time="60">{{addPhotoText}}</view>
    </view>
    <view class="img-list" wx:if="{{images.length}}">
      <view class="img-item" wx:for="{{images}}" wx:key="index">
        <image class="img" src="{{item.path}}" mode="aspectFill" bindtap="previewImage" data-idx="{{index}}" />
        <view class="img-remove" bindtap="removeImage" data-idx="{{index}}" hover-class="tap-down" hover-stay-time="60">移除</view>
      </view>
    </view>

    <view class="actions">
      <view class="btn-primary {{canSubmit ? '' : 'btn-primary--disabled'}}" bindtap="onSubmit" hover-class="tap-down" hover-stay-time="80">{{submitText}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
