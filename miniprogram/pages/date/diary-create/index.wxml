<view class="page">
  <view class="section">
    <view class="h">关联清单</view>

    <view class="plan-selector" bindtap="openPlanPicker" hover-class="tap-down" hover-stay-time="60">
      <view class="sel-left">
        <view class="sel-title" wx:if="{{useTemporary}}">临时约会</view>
        <view class="sel-title" wx:elif="{{planTitle}}">{{planTitle}}</view>
        <view class="sel-title placeholder" wx:else>选一条清单</view>
        <view class="sel-sub" wx:if="{{useTemporary}}">先把这一篇收好就行</view>
        <view class="sel-sub" wx:elif="{{planTitle}}">这篇会归在这条清单里</view>
        <view class="sel-sub" wx:else>也可以选「临时约会」</view>
      </view>
      <view class="sel-right">›</view>
    </view>

    <view class="plan-hint" wx:if="{{plans.length===0}}">清单里还空着，先去加一条想做的约会。</view>
  </view>

  <!-- plan picker sheet -->
  <view class="modal" wx:if="{{showPlanPicker}}" catchtap="closePlanPicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">选一条清单</view>
        <view class="sheet-close" bindtap="closePlanPicker">收起</view>
      </view>

      <scroll-view scroll-y class="sheet-list">
        <block wx:for="{{plans}}" wx:for-item="p" wx:key="id">
          <view class="sheet-item {{planId===p.id && !useTemporary?'on':''}}" data-id="{{p.id}}" bindtap="onPickPlan">
            <view class="sheet-item-title">{{p.title}}</view>
            <view class="sheet-item-mark">{{planId===p.id && !useTemporary ? '已选' : ''}}</view>
          </view>
        </block>

        <view class="sheet-divider"></view>

        <view class="sheet-item temp {{useTemporary?'on':''}}" bindtap="onUseTemporary">
          <view class="sheet-item-title">临时约会</view>
          <view class="sheet-item-desc">不放进清单，也可以收好这一篇</view>
          <view class="sheet-item-mark">{{useTemporary ? '已选' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="section">
    <view class="h">约会时间</view>
    <view class="time-row">
      <picker mode="date" value="{{occurDate}}" bindchange="onPickOccurDate">
        <view class="pick">{{occurDate}}</view>
      </picker>
      <picker mode="time" value="{{occurTime}}" bindchange="onPickOccurTime">
        <view class="pick">{{occurTime}}</view>
      </picker>
    </view>
  </view>

  <view class="section">
    <textarea class="textarea" placeholder="把这次约会，收进这里。" value="{{text}}" bindinput="onText" />

    <view class="imgs">
      <view class="img-add" bindtap="chooseImages">+ 添一张照片</view>
      <block wx:for="{{images}}" wx:key="path">
        <view class="img" bindtap="previewImage" data-idx="{{index}}">
          <image src="{{item.path}}" mode="aspectFill" />
          <view class="rm" bindtap="removeImage" data-idx="{{index}}">移除</view>
        </view>
      </block>
    </view>
  </view>

  <view class="bottom">
    <view class="btn {{canSubmit?'on':''}}" bindtap="onSubmit">收好</view>
  </view>
</view>
