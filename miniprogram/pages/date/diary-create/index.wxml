<view class="page">
  <view class="section">
    <view class="h">关联清单</view>

    <view class="plan-box">
      <view class="plan-list">
        <block wx:for="{{plans}}" wx:for-item="p" wx:key="id">
          <view class="plan-item {{planId===p.id && !useTemporary?'on':''}}" data-id="{{p.id}}" bindtap="onPickPlan">
            <view class="plan-title">{{p.title}}</view>
            <view class="plan-mark">{{planId===p.id && !useTemporary ? '已选' : ''}}</view>
          </view>
        </block>

        <view class="plan-item temp {{useTemporary?'on':''}}" bindtap="onUseTemporary">
          <view class="plan-title">临时约会</view>
          <view class="plan-mark">{{useTemporary ? '已选' : ''}}</view>
        </view>
      </view>

      <view class="plan-hint" wx:if="{{!useTemporary && !planId}}">先从清单里选一个（也可以用“临时约会”）</view>
      <view class="plan-hint" wx:if="{{plans.length===0}}">清单里还没有条目。先去约会清单加一条吧。</view>
    </view>
  </view>

  <view class="section">
    <view class="h">约会时间</view>
    <view class="time-row">
      <picker mode="date" value="{{occurDate}}" bindchange="onPickOccurDate">
        <view class="pick">{{occurDate}}</view>
      </picker>
      <picker mode="time" value="{{occurTime}}" bindchange="onPickOccurTime">
        <view class="pick">{{occurTime}}</view>
      </picker>
    </view>
  </view>

  <view class="section">
    <textarea class="textarea" placeholder="把这次约会，收进这里。" value="{{text}}" bindinput="onText" />

    <view class="imgs">
      <view class="img-add" bindtap="chooseImages">+ 添一张照片</view>
      <block wx:for="{{images}}" wx:key="path">
        <view class="img" bindtap="previewImage" data-idx="{{index}}">
          <image src="{{item.path}}" mode="aspectFill" />
          <view class="rm" bindtap="removeImage" data-idx="{{index}}">移除</view>
        </view>
      </block>
    </view>
  </view>

  <view class="bottom">
    <view class="btn {{canSubmit?'on':''}}" bindtap="onSubmit">收好</view>
  </view>
</view>
