<view class="page">
  <!-- Header -->
  <view class="header">
    <view class="h1">这一天的回忆</view>
    <view class="h2">和 {{taNickname}} 的一次约会</view>
  </view>

  <!-- Date emphasis -->
  <view class="date-emphasis">
    <view class="date-meta">
      <picker mode="date" value="{{occurDate}}" bindchange="onPickOccurDate">
        <view class="meta-item">{{metaDateText}}</view>
      </picker>
      <view class="dot">·</view>
      <view class="meta-item">{{metaWeekText}}</view>
      <view class="dot">·</view>
      <picker mode="time" value="{{occurTime}}" bindchange="onPickOccurTime">
        <view class="meta-item">{{occurTime}}</view>
      </picker>
    </view>
  </view>

  <!-- Media section (priority) -->
  <view class="media">
    <view wx:if="{{!images || images.length===0}}" class="add-photo" bindtap="chooseImages" hover-class="tap-down" hover-stay-time="60">+ 加一张那天的照片</view>

    <view wx:elif="{{images.length===1}}" class="single">
      <image class="single-img" src="{{images[0].path}}" mode="aspectFill" bindtap="previewImage" data-idx="0" lazy-load="true" />
      <view class="single-actions">
        <view class="mini" bindtap="chooseImages">再加一张</view>
        <view class="mini danger" bindtap="removeImage" data-idx="0">移除</view>
      </view>
    </view>

    <view wx:else class="grid">
      <view class="grid-row">
        <block wx:for="{{images}}" wx:key="path">
          <view class="grid-item" bindtap="previewImage" data-idx="{{index}}">
            <image class="grid-img" src="{{item.path}}" mode="aspectFill" lazy-load="true" />
            <view class="grid-rm" catchtap="removeImage" data-idx="{{index}}">移除</view>
          </view>
        </block>
        <view class="grid-add" wx:if="{{images.length<3}}" bindtap="chooseImages">+ 添一张</view>
      </view>
    </view>
  </view>

  <!-- Text section -->
  <view class="paper">
    <textarea
      class="textarea"
      placeholder="那天发生了什么？"
      value="{{text}}"
      bindinput="onText"
    />
  </view>

  <!-- Association (downgraded) -->
  <view class="assoc" bindtap="openPlanPicker" hover-class="tap-down" hover-stay-time="60">
    <view class="assoc-left">
      <view class="assoc-title">关联到某个清单</view>
      <view class="assoc-sub" wx:if="{{useTemporary}}">临时约会</view>
      <view class="assoc-sub" wx:elif="{{planTitle}}">{{planTitle}}</view>
      <view class="assoc-sub muted" wx:else>未关联</view>
    </view>
    <view class="assoc-right">›</view>
  </view>

  <!-- plan picker sheet (reuse existing logic) -->
  <view class="modal" wx:if="{{showPlanPicker}}" catchtap="closePlanPicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">选一条清单</view>
        <view class="sheet-close" bindtap="closePlanPicker">收起</view>
      </view>

      <scroll-view scroll-y class="sheet-list">
        <block wx:for="{{plans}}" wx:for-item="p" wx:key="id">
          <view class="sheet-item {{planId===p.id && !useTemporary?'on':''}}" data-id="{{p.id}}" bindtap="onPickPlan">
            <view class="sheet-item-title">{{p.title}}</view>
            <view class="sheet-item-mark">{{planId===p.id && !useTemporary ? '已选' : ''}}</view>
          </view>
        </block>

        <view class="sheet-divider"></view>

        <view class="sheet-item temp {{useTemporary?'on':''}}" bindtap="onUseTemporary">
          <view class="sheet-item-title">临时约会</view>
          <view class="sheet-item-desc">不放进清单，也可以收好这一篇</view>
          <view class="sheet-item-mark">{{useTemporary ? '已选' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Floating CTA -->
  <view class="cta">
    <view class="cta-btn {{canSubmit?'on':''}}" bindtap="onSubmit">把这一天留下</view>
  </view>
</view>
