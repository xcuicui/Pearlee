.page{padding:16rpx 24rpx 140rpx;}
.section{margin-bottom:22rpx;}
.h{font-size:28rpx;color:#334;margin-bottom:12rpx;}
.plan-box{background:rgba(255,255,255,.35);border-radius:18rpx;padding:14rpx 14rpx;}
.plan-list{display:flex;flex-direction:column;gap:12rpx;}
.plan-item{display:flex;align-items:center;justify-content:space-between;padding:14rpx 14rpx;border-radius:16rpx;background:rgba(255,255,255,.55);border:2rpx solid rgba(0,0,0,.04);}
.plan-item.temp{background:rgba(245,247,251,.75);}
.plan-item.on{border-color:rgba(95,125,149,.38);background:rgba(95,125,149,.10);}
.plan-title{font-size:28rpx;color:#223;max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.plan-mark{font-size:24rpx;color:rgba(38,35,31,.45);}
.plan-item.on .plan-mark{color:rgba(31,59,82,.85);}
.plan-hint{margin-top:10rpx;color:#889;font-size:26rpx;}

.time-row{display:flex;gap:14rpx;}
.pick{padding:14rpx 18rpx;border-radius:16rpx;background:#f6f7f9;color:#223;}

.textarea{background:#f6f7f9;border-radius:16rpx;padding:16rpx 18rpx;min-height:220rpx;}
.imgs{margin-top:16rpx;}
.img-add{display:inline-block;padding:10rpx 16rpx;border-radius:999rpx;background:#eef2f7;color:#5F7D95;font-size:26rpx;}
.img{margin-top:14rpx;position:relative;border-radius:18rpx;overflow:hidden;}
.img image{width:100%;height:240rpx;display:block;}
.rm{position:absolute;right:12rpx;top:12rpx;background:rgba(0,0,0,0.45);color:#fff;font-size:22rpx;padding:6rpx 10rpx;border-radius:999rpx;}

.bottom{position:fixed;left:0;right:0;bottom:0;padding:20rpx 24rpx 40rpx;background:rgba(250,249,247,0.9);backdrop-filter: blur(8px);}
.btn{width:100%;text-align:center;padding:18rpx 0;border-radius:999rpx;background:#d8dde2;color:#fff;font-size:30rpx;}
.btn.on{background:#5F7D95;}
