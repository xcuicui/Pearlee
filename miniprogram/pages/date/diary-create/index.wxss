.page{padding:26rpx 24rpx 180rpx;}

.header{margin-top:6rpx;}
.h1{font-size:40rpx;font-weight:700;letter-spacing:.2rpx;color:rgba(38,35,31,.92);}
.h2{margin-top:10rpx;font-size:24rpx;color:rgba(38,35,31,.52);}

.date-emphasis{position:relative;margin-top:18rpx;padding:16rpx 0 10rpx;}
.big-day{position:absolute;left:0;top:-10rpx;font-size:168rpx;line-height:1;font-weight:700;letter-spacing:-2rpx;color:rgba(95,125,149,.07);z-index:0;pointer-events:none;}
.date-meta{position:relative;z-index:1;display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;}
.meta-item{font-size:24rpx;color:rgba(38,35,31,.56);padding:8rpx 10rpx;border-radius:12rpx;background:rgba(255,255,255,.20);}
.dot{font-size:22rpx;color:rgba(38,35,31,.38);padding:0 4rpx;}

.media{margin-top:16rpx;}
.add-photo{display:inline-flex;align-items:center;padding:12rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.22);border:2rpx solid rgba(0,0,0,.04);color:rgba(95,125,149,.95);font-size:26rpx;}

.single{border-radius:22rpx;overflow:hidden;background:rgba(255,255,255,.30);border:2rpx solid rgba(0,0,0,.04);}
.single-img{width:100%;height:360rpx;display:block;}
.single-actions{display:flex;justify-content:space-between;padding:12rpx 16rpx;}
.mini{font-size:26rpx;color:rgba(95,125,149,.92);}
.mini.danger{color:rgba(210,67,67,.92);}

.grid-row{display:flex;gap:12rpx;flex-wrap:wrap;}
.grid-item{position:relative;width:calc((100% - 24rpx)/3);height:170rpx;border-radius:18rpx;overflow:hidden;background:rgba(255,255,255,.30);border:2rpx solid rgba(0,0,0,.04);}
.grid-img{width:100%;height:100%;display:block;}
.grid-rm{position:absolute;right:10rpx;top:10rpx;background:rgba(0,0,0,0.42);color:#fff;font-size:22rpx;padding:6rpx 10rpx;border-radius:999rpx;}
.grid-add{width:calc((100% - 24rpx)/3);height:170rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.18);border:2rpx dashed rgba(95,125,149,.28);color:rgba(95,125,149,.95);font-size:26rpx;}

.paper{margin-top:18rpx;padding:16rpx 16rpx 14rpx;border-radius:22rpx;background:rgba(255,255,255,.22);border:2rpx solid rgba(0,0,0,.04);}
.textarea{min-height:320rpx;font-size:30rpx;line-height:1.9;color:rgba(38,35,31,.9);}

.assoc{margin-top:16rpx;display:flex;align-items:center;justify-content:space-between;padding:14rpx 14rpx;border-radius:18rpx;background:rgba(255,255,255,.18);border:2rpx solid rgba(0,0,0,.03);}
.assoc-left{flex:1;min-width:0;}
.assoc-title{font-size:24rpx;color:rgba(38,35,31,.52);}
.assoc-sub{margin-top:8rpx;font-size:28rpx;color:rgba(38,35,31,.86);max-width:560rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.assoc-sub.muted{color:rgba(38,35,31,.42);}
.assoc-right{margin-left:12rpx;color:rgba(38,35,31,.35);font-size:34rpx;line-height:1;}

/* bottom sheet (reuse) */
.modal{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.35);display:flex;align-items:flex-end;z-index:999;}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:18rpx 18rpx 28rpx;}
.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;}
.sheet-title{font-size:30rpx;color:#223;font-weight:600;}
.sheet-close{font-size:26rpx;color:#5F7D95;padding:10rpx 12rpx;}
.sheet-list{max-height:56vh;}
.sheet-item{display:flex;align-items:center;justify-content:space-between;padding:16rpx 14rpx;border-radius:18rpx;background:rgba(245,247,251,.75);margin-top:12rpx;}
.sheet-item.on{background:rgba(95,125,149,.10);box-shadow:0 0 0 2rpx rgba(95,125,149,.22) inset;}
.sheet-item-title{font-size:28rpx;color:#223;max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sheet-item-desc{margin-top:6rpx;font-size:22rpx;color:rgba(38,35,31,.55);}
.sheet-item-mark{font-size:24rpx;color:rgba(38,35,31,.45);}
.sheet-item.on .sheet-item-mark{color:rgba(31,59,82,.85);}
.sheet-divider{height:2rpx;background:rgba(0,0,0,.05);margin-top:14rpx;}
.sheet-item.temp{background:rgba(255,170,190,.10);}

/* floating CTA */
.cta{position:fixed;left:0;right:0;bottom:0;padding:18rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);background:rgba(250,249,247,0.82);backdrop-filter: blur(10px);}
.cta-btn{width:100%;text-align:center;padding:18rpx 0;border-radius:999rpx;background:rgba(95,125,149,.18);color:rgba(95,125,149,.45);font-size:30rpx;}
.cta-btn.on{background:#5F7D95;color:#fff;}
