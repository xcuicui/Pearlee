.page{padding:16rpx 24rpx 140rpx;}
.section{margin-bottom:22rpx;}
.h{font-size:28rpx;color:#334;margin-bottom:12rpx;}

.plan-selector{display:flex;align-items:center;justify-content:space-between;padding:16rpx 16rpx;border-radius:18rpx;background:rgba(255,255,255,.35);border:2rpx solid rgba(0,0,0,.04);}
.sel-left{flex:1;min-width:0;}
.sel-title{font-size:30rpx;color:#223;max-width:560rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sel-title.placeholder{color:rgba(38,35,31,.42);}
.sel-sub{margin-top:8rpx;font-size:22rpx;color:rgba(38,35,31,.52);}
.sel-right{margin-left:12rpx;color:rgba(38,35,31,.38);font-size:34rpx;line-height:1;}
.plan-hint{margin-top:10rpx;color:#889;font-size:26rpx;}

.modal{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.35);display:flex;align-items:flex-end;z-index:999;}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:18rpx 18rpx 28rpx;}
.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;}
.sheet-title{font-size:30rpx;color:#223;font-weight:600;}
.sheet-close{font-size:26rpx;color:#5F7D95;padding:10rpx 12rpx;}
.sheet-list{max-height:56vh;}
.sheet-item{display:flex;align-items:center;justify-content:space-between;padding:16rpx 14rpx;border-radius:18rpx;background:rgba(245,247,251,.75);margin-top:12rpx;}
.sheet-item.on{background:rgba(95,125,149,.10);box-shadow:0 0 0 2rpx rgba(95,125,149,.22) inset;}
.sheet-item-title{font-size:28rpx;color:#223;max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sheet-item-desc{margin-top:6rpx;font-size:22rpx;color:rgba(38,35,31,.55);}
.sheet-item-mark{font-size:24rpx;color:rgba(38,35,31,.45);}
.sheet-item.on .sheet-item-mark{color:rgba(31,59,82,.85);}
.sheet-divider{height:2rpx;background:rgba(0,0,0,.05);margin-top:14rpx;}
.sheet-item.temp{background:rgba(255,170,190,.10);}

.time-row{display:flex;gap:14rpx;}
.pick{padding:14rpx 18rpx;border-radius:16rpx;background:#f6f7f9;color:#223;}

.textarea{background:#f6f7f9;border-radius:16rpx;padding:16rpx 18rpx;min-height:220rpx;}
.imgs{margin-top:16rpx;}
.img-add{display:inline-block;padding:10rpx 16rpx;border-radius:999rpx;background:#eef2f7;color:#5F7D95;font-size:26rpx;}
.img{margin-top:14rpx;position:relative;border-radius:18rpx;overflow:hidden;}
.img image{width:100%;height:240rpx;display:block;}
.rm{position:absolute;right:12rpx;top:12rpx;background:rgba(0,0,0,0.45);color:#fff;font-size:22rpx;padding:6rpx 10rpx;border-radius:999rpx;}

.bottom{position:fixed;left:0;right:0;bottom:0;padding:20rpx 24rpx 40rpx;background:rgba(250,249,247,0.9);backdrop-filter: blur(8px);}
.btn{width:100%;text-align:center;padding:18rpx 0;border-radius:999rpx;background:#d8dde2;color:#fff;font-size:30rpx;}
.btn.on{background:#5F7D95;}
