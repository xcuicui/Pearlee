.page{padding:16rpx 24rpx;}
.card{background:#fff;border-radius:24rpx;padding:22rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,0.04);}
.title{font-size:36rpx;color:#223;}
.notes{margin-top:10rpx;color:#556;font-size:28rpx;line-height:1.5;}
.row{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx;}
.sub{color:#334;font-size:28rpx;}
.link{color:#5F7D95;font-size:28rpx;}
.hint{color:#889;font-size:26rpx;}
.actions{margin-top:22rpx;display:flex;justify-content:flex-end;}
.btn{padding:14rpx 22rpx;border-radius:999rpx;font-size:28rpx;}
.btn.primary{background:#5F7D95;color:#fff;}
.btn.ghost{background:#f3f4f6;color:#334;}

.chips{margin-top:12rpx;display:flex;flex-wrap:wrap;gap:10rpx;}
.chip{padding:6rpx 14rpx;border-radius:999rpx;background:#eef2f7;color:#456;font-size:24rpx;}
.chip.selectable{background:#f3f4f6;color:#445;}
.chip.selectable.on{background:#dbe7f1;color:#1f3b52;}

.empty{padding:60rpx 0;color:#889;text-align:center;}
.tag-empty{padding:18rpx 0;color:#667;}
.tag-empty-title{font-size:26rpx;color:#334;}
.tag-empty-sub{margin-top:8rpx;font-size:22rpx;color:#667;}
.type-empty{padding:12rpx 0 6rpx;color:#667;}
.type-empty-text{font-size:22rpx;color:#556;}
.type-empty-sub{margin-top:6rpx;font-size:20rpx;color:#889;}

.modal{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.35);display:flex;align-items:flex-end;z-index:999;}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:24rpx;}
.sheet-title{font-size:32rpx;color:#223;margin-bottom:16rpx;}
.input{background:#f6f7f9;border-radius:16rpx;padding:16rpx 18rpx;margin-bottom:12rpx;}
.type-line{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx;}
.type-name{color:#334;font-size:26rpx;}
.mini{color:#5F7D95;font-size:26rpx;margin-top:10rpx;}
.sheet-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:20rpx;}
