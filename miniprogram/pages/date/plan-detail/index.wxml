<view class="page">
  <block wx:if="{{!item && !loading}}">
    <view class="empty">找不到这条清单项。</view>
  </block>

  <block wx:if="{{item}}">
    <view class="card">
      <view class="title">{{item.title}}</view>
      <view class="notes" wx:if="{{item.notes}}">{{item.notes}}</view>

      <view class="row">
        <view class="sub">标签</view>
        <view class="link" bindtap="openEditTags">编辑</view>
      </view>
      <view class="chips" wx:if="{{item.tags && item.tags.length}}">
        <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id">
          <view class="chip">{{tag.name}}</view>
        </block>
      </view>
      <view class="chips" wx:else>
        <view class="hint">还没有标签</view>
      </view>

      <view class="row" style="margin-top:18rpx;">
        <view class="sub">约会日记</view>
        <view class="link" bindtap="goDiaryCreate">写一篇</view>
      </view>
      <view class="hint" style="margin-top:8rpx;">把这次约会，收进这里。</view>

      <view class="actions">
        <view class="btn {{item.status==='done'?'ghost':'primary'}}" bindtap="toggleDone">{{item.status==='done'?'取消完成':'标记已完成'}}</view>
      </view>
    </view>
  </block>

  <!-- edit tags modal -->
  <view class="modal" wx:if="{{editingTags}}">
    <view class="sheet">
      <view class="sheet-title">编辑标签</view>

      <view wx:if="{{!tagTypes.length}}" class="tag-empty">
        <view class="tag-empty-title">还没有标签类型</view>
        <view class="tag-empty-sub">建议先建「地点」「氛围」这两类</view>
        <view class="mini" bindtap="openAddType">+ 新增类型</view>
      </view>

      <block wx:else>
        <block wx:for="{{tagTypes}}" wx:for-item="type" wx:key="id">
        <view class="type-block">
          <view class="type-line">
            <view class="type-name" data-typeid="{{type.id}}" data-name="{{type.name}}" bindlongpress="onLongPressType">{{type.name}}</view>
            <view class="mini" data-typeid="{{type.id}}" bindtap="openAddTag">+ 标签</view>
          </view>

        <view wx:if="{{!(tagsByType[type.id] && tagsByType[type.id].length)}}" class="type-empty">
          <view class="type-empty-text">还没有「{{type.name}}」标签</view>
          <view class="type-empty-sub">{{hintByTypeName[type.name] || '比如：写下你们常去/想去的关键词'}}</view>
        </view>

        <view class="chips" wx:else>
          <block wx:for="{{tagsByType[type.id]}}" wx:for-item="tag" wx:key="id">
            <view
              class="chip selectable {{editSelectedTagMap[tag.id]?'on':''}}"
              data-id="{{tag.id}}"
              data-name="{{tag.name}}"
              catchtap="toggleEditTag"
              bindlongpress="onLongPressTag"
            >{{tag.name}}</view>
          </block>
        </view>
        </view>
        </block>
      </block>

      <view wx:if="{{tagTypes.length}}" class="mini" bindtap="openAddType">+ 类型</view>

      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeEditTags">取消</view>
        <view class="btn primary" bindtap="saveTags">保存</view>
      </view>
    </view>
  </view>

  <!-- add type modal -->
  <view class="modal" wx:if="{{showAddType}}">
    <view class="sheet">
      <view class="sheet-title">新增标签类型</view>
      <input class="input" placeholder="例如：约束/类型" value="{{newTypeName}}" bindinput="onNewTypeName" />
      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeAddType">取消</view>
        <view class="btn primary" bindtap="submitAddType">新增</view>
      </view>
    </view>
  </view>

  <!-- add tag modal -->
  <view class="modal" wx:if="{{showAddTag}}">
    <view class="sheet">
      <view class="sheet-title">新增标签</view>
      <input class="input" placeholder="例如：深圳/夜生活" value="{{newTagName}}" bindinput="onNewTagName" />
      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeAddTag">取消</view>
        <view class="btn primary" bindtap="submitAddTag">新增</view>
      </view>
    </view>
  </view>
</view>
