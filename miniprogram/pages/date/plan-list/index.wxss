.page{padding:16rpx 24rpx;}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;}
.seg{display:flex;background:#f2f2f2;border-radius:999rpx;overflow:hidden;}
.seg-item{padding:12rpx 22rpx;color:#667;}
.seg-item.on{background:#fff;color:#223;}
.actions .btn{padding:12rpx 18rpx;background:#5F7D95;color:#fff;border-radius:999rpx;font-size:28rpx;}

.filter{margin-bottom:12rpx;}
.filter-all{margin-bottom:10rpx;}
.filter-type-row{margin-top:10rpx;}
.filter-type-name{font-size:22rpx;color:rgba(38,35,31,.55);margin-bottom:8rpx;}
.tag-row{white-space:nowrap;}
.tag{display:inline-block;padding:10rpx 18rpx;margin-right:12rpx;border-radius:999rpx;background:#f3f4f6;color:#556;font-size:26rpx;border:2rpx solid rgba(0,0,0,0);}
.tag.on{box-shadow:0 0 0 2rpx rgba(95,125,149,.22) inset;}
.tag.all{background:#f3f4f6;color:#556;}
.tag.all.on{background:#5F7D95;color:#fff;box-shadow:none;}

.list .card{background:#fff;border-radius:24rpx;padding:20rpx 22rpx;margin-bottom:16rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,0.04);}
.title{font-size:32rpx;color:#223;}
.chips{margin-top:12rpx;display:flex;flex-wrap:wrap;gap:10rpx;}
.chip{padding:6rpx 14rpx;border-radius:999rpx;background:#eef2f7;color:#456;font-size:24rpx;border:2rpx solid rgba(0,0,0,0);}
.chip.selectable{background:#f3f4f6;color:#445;}
.chip.selectable.on{box-shadow:0 0 0 2rpx rgba(38,35,31,.18) inset, 0 10rpx 22rpx rgba(0,0,0,.06);}
.check{margin-right:8rpx;font-size:22rpx;color:rgba(38,35,31,.62);}
.empty{padding:60rpx 0;color:#889;text-align:center;}
.tag-empty{padding:18rpx 0;color:#667;}
.tag-empty-title{font-size:26rpx;color:#334;}
.tag-empty-sub{margin-top:8rpx;font-size:22rpx;color:#667;}
.type-empty{padding:12rpx 0 6rpx;color:#667;}
.type-empty-text{font-size:22rpx;color:#556;}
.type-empty-sub{margin-top:6rpx;font-size:20rpx;color:#889;}

.modal{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.35);display:flex;align-items:flex-end;z-index:999;}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:24rpx;}
.sheet-title{font-size:32rpx;color:#223;margin-bottom:16rpx;}
.sheet-sub{margin-top:18rpx;color:#667;font-size:26rpx;}
.input{background:#f6f7f9;border-radius:16rpx;padding:16rpx 18rpx;margin-bottom:12rpx;}
.textarea{background:#f6f7f9;border-radius:16rpx;padding:16rpx 18rpx;min-height:160rpx;}
.type-block{padding-top:14rpx;margin-top:14rpx;border-top:2rpx solid rgba(0,0,0,.05);}
.type-line{display:flex;align-items:center;justify-content:space-between;margin-top:0;}
.type-name{color:#223;font-size:26rpx;font-weight:600;}
.mini{color:#5F7D95;font-size:26rpx;margin-top:10rpx;}
.sheet-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:20rpx;}
.btn{padding:14rpx 22rpx;border-radius:999rpx;font-size:28rpx;}
.btn.ghost{background:#f3f4f6;color:#334;}
.btn.primary{background:#5F7D95;color:#fff;}
