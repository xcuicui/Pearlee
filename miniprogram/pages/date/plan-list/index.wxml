<view class="page">
  <view class="topbar">
    <view class="seg">
      <view class="seg-item {{status==='open'?'on':''}}" data-status="open" bindtap="onToggleStatus">未完成</view>
      <view class="seg-item {{status==='done'?'on':''}}" data-status="done" bindtap="onToggleStatus">已完成</view>
    </view>
    <view class="actions">
      <view class="btn" bindtap="openCreate">新增</view>
    </view>
  </view>

  <view class="filter">
    <view class="filter-all">
      <view class="tag all {{selectedTagId===''?'on':''}}" bindtap="onSelectTag" data-id="">全部</view>
    </view>

    <view wx:if="{{!tagTypes.length}}" class="tag-empty">
      <view class="tag-empty-title">还没有标签类型</view>
      <view class="tag-empty-sub">你可以先从「地点」「氛围」开始</view>
    </view>

    <block wx:else>
      <block wx:for="{{tagTypes}}" wx:for-item="type" wx:key="id">
        <view class="filter-type-row">
          <view class="filter-type-name">{{type.name}}</view>
          <scroll-view scroll-x class="tag-row">
            <block wx:for="{{tagsByType[type.id]}}" wx:for-item="tag" wx:key="id">
              <view
                class="tag {{selectedTagId===tag.id?'on':''}}"
                style="{{typeColorStyleById[tag.typeId]}}"
                data-id="{{tag.id}}"
                data-name="{{tag.name}}"
                bindtap="onSelectTag"
                bindlongpress="onLongPressTag"
              >{{tag.name}}</view>
            </block>
          </scroll-view>
        </view>
      </block>
    </block>
  </view>

  <view class="list">
    <block wx:if="{{items.length===0 && !loading}}">
      <view class="empty">先把想一起做的事收进来。</view>
    </block>
    <block wx:for="{{items}}" wx:for-item="plan" wx:key="id">
      <view class="card" data-id="{{plan.id}}" bindtap="onOpenDetail">
        <view class="title">{{plan.title}}</view>
        <view class="chips" wx:if="{{plan.tags && plan.tags.length}}">
          <block wx:for="{{plan.tags}}" wx:for-item="tag" wx:key="id">
            <view class="chip" style="{{typeColorStyleById[tag.typeId]}}">{{tag.name}}</view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <!-- create modal -->
  <view class="modal" wx:if="{{showCreate}}">
    <view class="sheet">
      <view class="sheet-title">新增清单项</view>
      <input class="input" placeholder="想一起做什么？" value="{{newTitle}}" bindinput="onNewTitle" />
      <textarea class="textarea" placeholder="可选：写点备注" value="{{newNotes}}" bindinput="onNewNotes" />

      <view class="sheet-sub">选择标签（可选）</view>
      <view wx:if="{{!tagTypes.length}}" class="tag-empty">
        <view class="tag-empty-title">还没有标签类型</view>
        <view class="tag-empty-sub">建议先建「地点」「氛围」这两类</view>
        <view class="mini" bindtap="openAddType">+ 新增类型</view>
      </view>

      <block wx:else>
        <block wx:for="{{tagTypes}}" wx:for-item="type" wx:key="id">
          <view class="type-block">
            <view class="type-line">
              <view class="type-name" data-typeid="{{type.id}}" data-name="{{type.name}}" bindlongpress="onLongPressType">{{type.name}}</view>
              <view class="mini" data-typeid="{{type.id}}" bindtap="openAddTag">+ 标签</view>
            </view>

            <view wx:if="{{!(tagsByType[type.id] && tagsByType[type.id].length)}}" class="type-empty">
              <view class="type-empty-text">还没有「{{type.name}}」标签</view>
              <view class="type-empty-sub">{{hintByTypeName[type.name] || '比如：写下你们常去/想去的关键词'}}</view>
            </view>

            <view class="chips" wx:else>
              <block wx:for="{{tagsByType[type.id]}}" wx:for-item="tag" wx:key="id">
                <view
                  class="chip selectable {{newSelectedTagMap[tag.id]?'on':''}}"
                  style="{{typeColorStyleById[tag.typeId]}}"
                  data-id="{{tag.id}}"
                  data-name="{{tag.name}}"
                  bindtap="toggleNewTag"
                  bindlongpress="onLongPressTag"
                ><text wx:if="{{newSelectedTagMap[tag.id]}}" class="check">✓</text>{{tag.name}}</view>
              </block>
            </view>
          </view>
        </block>
      </block>

      <view wx:if="{{tagTypes.length}}" class="mini" bindtap="openAddType">+ 类型</view>

      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeCreate">取消</view>
        <view class="btn primary" bindtap="submitCreate">加入清单</view>
      </view>
    </view>
  </view>

  <!-- add type modal -->
  <view class="modal" wx:if="{{showAddType}}">
    <view class="sheet">
      <view class="sheet-title">新增标签类型</view>
      <input class="input" placeholder="例如：类型/约束" value="{{newTypeName}}" bindinput="onNewTypeName" />
      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeAddType">取消</view>
        <view class="btn primary" bindtap="submitAddType">新增</view>
      </view>
    </view>
  </view>

  <!-- add tag modal -->
  <view class="modal" wx:if="{{showAddTag}}">
    <view class="sheet">
      <view class="sheet-title">新增标签</view>
      <input class="input" placeholder="例如：深圳/夜生活" value="{{newTagName}}" bindinput="onNewTagName" />
      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeAddTag">取消</view>
        <view class="btn primary" bindtap="submitAddTag">新增</view>
      </view>
    </view>
  </view>
</view>
