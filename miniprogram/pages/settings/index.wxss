.page{padding:48rpx}
.section{padding:38rpx 36rpx;margin-bottom:26rpx}
.title{font-size:30rpx;font-weight:600;margin-bottom:22rpx}
.row{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.label{font-size:24rpx;color:rgba(38,35,31,.55)}
.input{flex:1;margin-left:20rpx;text-align:right;font-size:26rpx;color:rgba(38,35,31,.78)}
.picker{text-align:right;font-size:26rpx;color:rgba(38,35,31,.78)}
.desc{font-size:24rpx;line-height:1.7;color:rgba(38,35,31,.55)}
.code{margin-top:14rpx;font-size:34rpx;font-weight:700;letter-spacing:2rpx;color:rgba(95,125,149,.92)}
.actions{margin-top:18rpx;display:flex;gap:16rpx;flex-wrap:wrap}
.danger{margin-top:10rpx}
.danger-btn{color:rgba(195,72,72,.92)}
.err{margin-top:22rpx;color:#b24a4a;font-size:24rpx}
