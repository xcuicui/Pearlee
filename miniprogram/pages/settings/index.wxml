<view class="page">
  <view class="card section">
    <view class="title">{{titleRel}}</view>

    <view class="row">
      <view class="label">{{labelNickname}}</view>
      <input class="input" value="{{nickname}}" placeholder="{{nicknamePlaceholder}}" bindinput="onNickname" />
    </view>

    <view class="row">
      <view class="label">{{labelStartDate}}</view>
      <picker mode="date" value="{{startDate}}" bindchange="onPickDate">
        <view class="picker">{{startDate || datePickPlaceholder}} </view>
      </picker>
    </view>

    <view class="actions">
      <view class="btn-primary" bindtap="save" hover-class="tap-down" hover-stay-time="80">{{saveText}}</view>
    </view>
  </view>

  <view class="card section">
    <view class="title">{{titleInvite}}</view>
    <view class="desc">{{inviteDesc}}</view>
    <view class="code">{{inviteCode || '—'}}</view>

    <view class="actions">
      <view class="btn-ghost" bindtap="copy" hover-class="tap-down" hover-stay-time="80">{{copyCodeText}}</view>
      <view class="btn-ghost" bindtap="goJoin" hover-class="tap-down" hover-stay-time="80">{{goJoinText}}</view>
    </view>
  </view>

  <view class="danger">
    <view class="btn-ghost danger-btn" bindtap="archive" hover-class="tap-down" hover-stay-time="80">{{archiveText}}</view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
