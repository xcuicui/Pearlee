<view class="page">
  <view class="hero">
    <view class="hero-title">{{titleText}}</view>
  </view>

  <view class="card section">
    <view class="section-title">{{sourceTitleText}}</view>
    <view class="line" wx:for="{{sourceLines}}" wx:key="index">{{item}}</view>
  </view>

  <view class="card section">
    <view class="section-title">{{usageTitleText}}</view>
    <view class="line" wx:for="{{usageLines}}" wx:key="index">{{item}}</view>
  </view>

  <view class="card section">
    <view class="section-title">{{tipsTitleText}}</view>
    <view class="line" wx:for="{{tipsLines}}" wx:key="index">{{item}}</view>
  </view>
</view>
