.page{padding:48rpx;min-height:100vh;box-sizing:border-box;background:#faf9f7}
.form-item{padding:28rpx 24rpx;margin-bottom:18rpx}
.label{font-size:24rpx;color:rgba(38,35,31,.65);margin-bottom:14rpx}
.input{height:72rpx;line-height:72rpx;font-size:28rpx;color:rgba(38,35,31,.86)}
.textarea{width:100%;height:160rpx;font-size:26rpx;line-height:1.6;color:rgba(38,35,31,.86)}
.option-list{display:flex;flex-direction:column;gap:12rpx}
.option{padding:18rpx;border-radius:16rpx;border:1rpx solid rgba(95,125,149,.16);background:rgba(255,255,255,.6)}
.option.is-active{border-color:rgba(95,125,149,.56);background:rgba(95,125,149,.08)}
.option-title{font-size:26rpx;color:rgba(38,35,31,.84);font-weight:600}
.option-desc{margin-top:8rpx;font-size:22rpx;color:rgba(38,35,31,.56)}
.recipient-row{display:flex;gap:12rpx;flex-wrap:wrap}
.recipient-item{padding:12rpx 22rpx;border-radius:999rpx;font-size:24rpx;color:rgba(38,35,31,.66);background:rgba(38,35,31,.08)}
.recipient-item.is-active{color:rgba(95,125,149,.95);background:rgba(95,125,149,.14)}
.submit{margin-top:26rpx}
.submit.is-disabled{opacity:.45;pointer-events:none}
