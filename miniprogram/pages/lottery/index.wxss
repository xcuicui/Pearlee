.page{padding:48rpx;min-height:100vh;box-sizing:border-box;background:#faf9f7}
.hero{margin-bottom:18rpx}
.hero-title{font-size:44rpx;font-weight:600;color:rgba(38,35,31,.92)}
.hero-subtitle{margin-top:10rpx;font-size:24rpx;color:rgba(38,35,31,.58)}
.section{padding:34rpx 30rpx;margin-bottom:24rpx}
.assets-line{font-size:28rpx;color:rgba(38,35,31,.78)}
.draw-btn{width:100%;box-sizing:border-box}
.btn-primary--disabled{opacity:.45;pointer-events:none}
.draw-under-text{margin-top:14rpx;font-size:23rpx;color:rgba(38,35,31,.5);text-align:center}
.pocket-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:18rpx}
.pocket-head .title{margin-bottom:0}
.title{font-size:30rpx;font-weight:600;margin-bottom:18rpx}
.pocket-link{font-size:24rpx;color:rgba(95,125,149,.92);padding-left:12rpx}
.pocket-list{display:flex;flex-direction:column;gap:16rpx}
.pocket-item{padding:18rpx;border-radius:18rpx;background:rgba(255,255,255,.7);border:1rpx solid rgba(95,125,149,.12)}
.pocket-name{font-size:26rpx;font-weight:500;color:rgba(38,35,31,.82)}
.pocket-desc{margin-top:8rpx;font-size:23rpx;line-height:1.6;color:rgba(38,35,31,.62)}
.pocket-time{margin-top:8rpx;font-size:21rpx;color:rgba(38,35,31,.46)}
.pocket-empty{font-size:24rpx;color:rgba(38,35,31,.5)}
.window-entry-wrap{padding:12rpx 0 2rpx}
.window-entry{padding:14rpx 0;text-align:center;font-size:28rpx;color:rgba(95,125,149,.92)}

.ceremony-overlay{
  position:fixed;
  inset:0;
  z-index:50;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  box-sizing:border-box;
  background:rgba(24,22,18,.6);
  opacity:0;
  transition:opacity 180ms ease-out;
}
.ceremony-overlay.is-visible{opacity:1}
.ceremony-overlay.is-leaving{opacity:0}
@supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) {
  .ceremony-overlay{
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
  }
}

.ceremony-card{
  width:100%;
  max-width:620rpx;
  border-radius:28rpx;
  padding:40rpx 34rpx 32rpx;
  box-sizing:border-box;
  background:rgba(255,255,255,.96);
  box-shadow:0 20rpx 60rpx rgba(23,20,18,.16);
  transform:translateY(8px) scale(.95);
  opacity:0;
}
.ceremony-card.is-drawing,
.ceremony-card.is-result{
  animation:ceremony-enter 360ms ease-out forwards;
}
@keyframes ceremony-enter{
  from{transform:translateY(8px) scale(.95);opacity:0}
  to{transform:translateY(0) scale(1);opacity:1}
}
.ceremony-top{font-size:24rpx;color:rgba(38,35,31,.55);text-align:center}
.ceremony-title{margin-top:14rpx;font-size:44rpx;line-height:1.2;font-weight:600;color:rgba(38,35,31,.9);text-align:center}
.ceremony-desc{margin-top:14rpx;font-size:26rpx;line-height:1.7;color:rgba(38,35,31,.64);text-align:center}
.ceremony-btn{margin-top:28rpx}
.ceremony-footer{margin-top:14rpx;font-size:22rpx;color:rgba(38,35,31,.45);text-align:center}
.ceremony-loading{margin-top:24rpx;font-size:48rpx;line-height:1;text-align:center;color:rgba(95,125,149,.8)}
