.page{padding:48rpx;min-height:100vh;box-sizing:border-box;background:#faf9f7}
.hero{margin-bottom:18rpx}
.hero-title{font-size:44rpx;font-weight:600;color:rgba(38,35,31,.92)}
.hero-subtitle{margin-top:10rpx;font-size:24rpx;color:rgba(38,35,31,.58)}
.section{padding:34rpx 30rpx;margin-bottom:24rpx}
.gift-list{display:flex;flex-direction:column;gap:16rpx}
.gift-item{padding:18rpx;border-radius:18rpx;background:rgba(255,255,255,.7);border:1rpx solid rgba(95,125,149,.12)}
.gift-head{display:flex;justify-content:space-between;align-items:center}
.gift-name{font-size:26rpx;font-weight:500;color:rgba(38,35,31,.82)}
.gift-rarity{font-size:22rpx;color:rgba(95,125,149,.8)}
.gift-desc{margin-top:8rpx;font-size:23rpx;line-height:1.6;color:rgba(38,35,31,.62)}
