.page{padding:48rpx;min-height:100vh;box-sizing:border-box;background:#faf9f7}
.hero{margin-bottom:18rpx}
.hero-title{font-size:44rpx;font-weight:600;color:rgba(38,35,31,.92)}
.hero-subtitle{margin-top:10rpx;font-size:24rpx;color:rgba(38,35,31,.58)}
.segmented{display:flex;align-items:center;padding:8rpx;border-radius:20rpx;gap:8rpx;margin-bottom:20rpx}
.seg-item{flex:1;text-align:center;font-size:26rpx;line-height:1;padding:18rpx 0;border-radius:14rpx;color:rgba(38,35,31,.62)}
.seg-item.is-active{background:#fff;color:rgba(38,35,31,.9);font-weight:600;box-shadow:0 4rpx 14rpx rgba(23,20,18,.08)}
.add-wrap{display:flex;justify-content:flex-end;margin:0 0 20rpx}
.add-btn{font-size:24rpx;color:rgba(95,125,149,.92);padding:10rpx 0}
.gift-list{display:flex;flex-direction:column;gap:16rpx}
.gift-item{padding:24rpx 22rpx}
.gift-head{display:flex;justify-content:space-between;align-items:center;gap:12rpx}
.gift-name{font-size:28rpx;font-weight:600;color:rgba(38,35,31,.84)}
.gift-rarity{font-size:22rpx;padding:6rpx 14rpx;border-radius:999rpx;color:rgba(95,125,149,.9);background:rgba(95,125,149,.1)}
.gift-desc{margin-top:12rpx;font-size:24rpx;line-height:1.65;color:rgba(38,35,31,.65)}
.gift-source{margin-top:10rpx;font-size:22rpx;color:rgba(38,35,31,.48)}
.gift-actions{margin-top:14rpx;display:flex;justify-content:flex-end}
.gift-delete{font-size:24rpx;color:#a96d6d;padding:8rpx 0}
.gift-delete.is-disabled{opacity:.45;pointer-events:none}
.empty{padding:34rpx 28rpx;border-radius:24rpx;background:rgba(255,255,255,.82);font-size:26rpx;color:rgba(38,35,31,.5)}
