<view class="page">
  <view class="hero">
    <view class="hero-title">{{titleText}}</view>
    <view class="hero-subtitle">{{subtitleText}}</view>
  </view>

  <view class="card section">
    <view class="gift-list">
      <view class="gift-item" wx:for="{{gifts}}" wx:key="prize_key">
        <view class="gift-head">
          <view class="gift-name">{{item.title}}</view>
          <view class="gift-rarity">{{item.rarityText}}</view>
        </view>
        <view class="gift-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>
