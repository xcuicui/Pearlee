<view class="home">
  <view class="bg"></view>

  <view class="top">
    <view class="rel-title">和 {{nickname}} 的第 <text class="days">{{days}}</text> 天</view>
    <view wx:if="{{streak.visible}}" class="streak">{{streakText}}</view>
  </view>

  <view class="week card">
    <view class="week-head">
      <view class="week-range">{{weekTitle}}</view>
      <view class="week-actions" aria-hidden="true">
        <view
          class="checkin-pill {{checkinDone ? 'done' : ''}} {{checkinLoading ? 'loading' : ''}}"
          bindtap="onCheckin"
          hover-class="tap-down"
          hover-stay-time="60"
        >{{checkinText}}</view>
        <view class="week-today" bindtap="goTodayWeek" hover-class="tap-down" hover-stay-time="60">{{weekTodayText}}</view>
        <view class="week-arrow" bindtap="tapPrevWeek" hover-class="tap-down" hover-stay-time="60">‹</view>
        <view class="week-arrow" bindtap="tapNextWeek" hover-class="tap-down" hover-stay-time="60">›</view>
      </view>
    </view>
    <view class="checkin-tip-row">
      <view class="checkin-tip-text">{{checkinTipText}}</view>
      <view class="checkin-tip-link" bindtap="goPointsHelp" hover-class="tap-down" hover-stay-time="60">{{pointsHelpLinkText}}</view>
    </view>

    <swiper
      class="week-swiper"
      current="{{swiperCurrent}}"
      duration="240"
      easing-function="easeOutCubic"
      circular="true"
      skip-hidden-item-layout="true"
      bindanimationfinish="onWeekSwipeFinish"
    >
      <swiper-item wx:for="{{weekPages}}" wx:for-index="idx" wx:key="idx">
        <view class="week-bar">
          <view class="mood-overlay" aria-hidden="true">
            <view wx:for="{{item.moodLines}}" wx:key="key" class="mood-line" style="{{item.style}}"></view>
            <view wx:for="{{item.moodDots}}" wx:key="key" class="mood-dot" style="{{item.style}}"></view>
          </view>
          <view
            class="week-day"
            wx:for="{{item.days}}"
            wx:key="date"
            data-key="{{item.date}}"
            bindtap="onPickDay"
          >
            <view class="week-chip {{item.isToday ? 'today' : ''}}">
              <view class="week-name">{{item.weekLabel}}</view>
              <view class="week-num">{{item.dayLabel}}</view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view wx:if="{{!cards.length}}" class="emotion card" bindtap="openEmotion" hover-class="tap-down" hover-stay-time="80">
    <view class="emotion-empty">
      <view class="emotion-time">{{emotionEmptyTimeText}}</view>
      <view class="emotion-text">{{emotionEmptyText}}</view>
      <view class="emotion-from">{{emotionFromText}}</view>
    </view>
  </view>

  <view wx:else class="emotion-swiper-wrap">
    <swiper
      class="emotion-swiper"
      current="{{activeCardIndex}}"
      duration="220"
      indicator-dots="false"
      previous-margin="24rpx"
      next-margin="24rpx"
      bindchange="onCardSwiperChange"
    >
      <swiper-item wx:for="{{cards}}" wx:key="id">
        <view class="emotion card emotion-item" bindtap="openEmotion" hover-class="tap-down" hover-stay-time="80">
          <view class="emotion-time">{{item.timeText}}</view>
          <view wx:if="{{item.moodText}}" class="emotion-mood">{{item.moodText}}</view>

          <view wx:if="{{item.images && item.images.length}}" class="emotion-images" aria-label="emotion images">
            <image
              class="emotion-image"
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="aspectFill"
              lazy-load="true"
            />
          </view>

          <view wx:elif="{{item.coverImage}}" class="emotion-media" aria-label="emotion image">
            <image class="emotion-img" src="{{item.coverImage}}" mode="aspectFill" lazy-load="true" />
          </view>

          <text class="emotion-text">{{item.text}}</text>
          <view class="emotion-from">{{emotionFromText}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="write-hub card">
    <view class="hub-title">写点什么</view>
    <view class="hub-row">
      <view class="hub-item" bindtap="goDatePlanList" hover-class="tap-down" hover-stay-time="60">
        <view class="hub-name">约会清单</view>
        <view class="hub-desc">把想做的先收起来</view>
      </view>
      <view class="hub-item" bindtap="goDateDiary" hover-class="tap-down" hover-stay-time="60">
        <view class="hub-name">约会日记</view>
        <view class="hub-desc">把这次约会收好</view>
      </view>
      <view class="hub-item" bindtap="goPublish" hover-class="tap-down" hover-stay-time="60">
        <view class="hub-name">碎碎念</view>
        <view class="hub-desc">想到你的一刻</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goPublish" hover-class="tap-down" hover-stay-time="80" aria-label="{{fabAriaLabel}}">
    <view class="fab-bubble">{{fabBubbleText}}</view>
    <view class="fab-icon">+</view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
