<view class="home">
  <view class="bg"></view>

  <view class="top">
    <view class="rel-title">和 {{nickname}} 的第 <text class="days">{{days}}</text> 天</view>
    <view wx:if="{{streak.visible}}" class="streak">最近 {{streak.current}} 天都有记录</view>
  </view>

  <view
    class="week card"
    catchtouchstart="onWeekTouchStart"
    catchtouchend="onWeekTouchEnd"
  >
    <view class="week-head">
      <view class="week-range">{{weekTitle}}</view>
      <view class="week-actions">
        <view class="week-btn" bindtap="prevWeek" hover-class="tap-down" hover-stay-time="60">上周</view>
        <view class="week-btn" bindtap="nextWeek" hover-class="tap-down" hover-stay-time="60">下周</view>
      </view>
    </view>
    <view class="week-bar">
      <view
        class="week-day"
        wx:for="{{weekDays}}"
        wx:key="date"
        data-key="{{item.date}}"
        bindtap="onPickDay"
      >
        <view class="week-chip {{item.isToday ? 'today' : ''}}">
          <view class="week-name">{{item.weekLabel}}</view>
          <view class="week-num">{{item.dayLabel}}</view>
          <view class="dot-row {{item.hasRecord ? 'active' : ''}} {{item.hasRecord && item.recordLevel === 2 ? 'lv2' : ''}}">
            <view class="dot"></view>
            <view wx:if="{{item.hasRecord && item.recordLevel === 2}}" class="dot ghost"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="emotion card" bindtap="openEmotion" hover-class="tap-down" hover-stay-time="80">
    <view wx:if="{{emotion.empty}}" class="emotion-empty">
      <view class="emotion-time">现在</view>
      <view class="emotion-text">写一句给 TA 的话吧。</view>
      <view class="emotion-from">来自你们</view>
    </view>

    <view wx:else>
      <view class="emotion-time">{{emotion.timeText}}</view>

      <view wx:if="{{emotion.coverImage}}" class="emotion-media" aria-label="emotion image">
        <image class="emotion-img" src="{{emotion.coverImage}}" mode="aspectFill" lazy-load="true" />
      </view>

      <view class="emotion-text">{{emotion.text}}</view>
      <view class="emotion-from">来自 {{emotion.from}}</view>
    </view>
  </view>

  <view class="today card">
    <view wx:if="{{today.hasAny}}" class="today-text">今天已被点亮</view>
    <view wx:else class="today-text">今天还没有留下记录</view>

    <view class="today-actions">
      <view class="btn-primary" bindtap="goPublish" hover-class="tap-down" hover-stay-time="80">记录这一刻</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
