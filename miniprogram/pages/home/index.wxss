.home{position:relative;min-height:100vh;padding:48rpx 48rpx 192rpx;box-sizing:border-box}
.bg{position:fixed;inset:0;z-index:0;background:
  radial-gradient(800rpx 600rpx at 22% 12%, rgba(95,125,149,.22), rgba(255,255,255,0) 60%),
  radial-gradient(900rpx 700rpx at 78% 22%, rgba(255,170,190,.14), rgba(255,255,255,0) 62%),
  linear-gradient(180deg,#f5f7fb 0%,#f8f3f6 48%,#faf9f7 100%);
}
.top{position:relative;z-index:1;margin-top:10rpx;margin-bottom:36rpx}
.rel-title{font-size:34rpx;font-weight:600;letter-spacing:.2rpx}
.days{color:rgba(95,125,149,.95)}
.streak{margin-top:12rpx;font-size:24rpx;color:rgba(38,35,31,.62)}
.week{position:relative;z-index:1;padding:24rpx 22rpx;margin-bottom:28rpx}
.week-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx}
.week-range{font-size:26rpx;font-weight:600}
.week-actions{display:flex;gap:8rpx;align-items:center}
.week-today{padding:10rpx 16rpx;border-radius:999rpx;font-size:22rpx;color:rgba(38,35,31,.38);background:rgba(255,255,255,.18)}
.week-arrow{width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;color:rgba(38,35,31,.32);background:rgba(255,255,255,.28);font-size:30rpx;line-height:1}
.week-swiper{height:138rpx}
.week-bar{display:flex;justify-content:space-between;gap:10rpx;padding:4rpx 0}
.week-day{flex:1;display:flex;align-items:center;justify-content:center}
.week-chip{width:76rpx;height:118rpx;padding:12rpx 8rpx 10rpx;border-radius:999rpx;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;box-sizing:border-box;background:rgba(255,255,255,.18);border:2rpx solid rgba(255,255,255,0)}
.week-chip.today{background:rgba(95,125,149,.08);border-color:rgba(95,125,149,.32);padding-top:10rpx}
.week-name{font-size:20rpx;height:20rpx;display:flex;align-items:center;justify-content:center;color:rgba(38,35,31,.52)}
.week-num{margin-top:12rpx;font-size:28rpx;height:32rpx;display:flex;align-items:center;justify-content:center;font-weight:600;color:rgba(38,35,31,.82)}
.dot-row{margin-top:12rpx;height:16rpx;display:flex;align-items:center;justify-content:center;gap:5rpx;opacity:0}
.dot-row.active{opacity:1}
.dot{width:10rpx;height:10rpx;border-radius:999rpx;background:rgba(95,125,149,.58)}
.dot-row.lv2 .dot{width:12rpx;height:12rpx;background:rgba(95,125,149,.72)}
.dot.ghost{opacity:.9}
.emotion{position:relative;z-index:1;padding:44rpx 40rpx;margin-bottom:28rpx}
.emotion-swiper-wrap{position:relative;z-index:1;margin-bottom:28rpx}
.emotion-swiper{height:640rpx}
.emotion-item{height:100%;margin-bottom:0;box-sizing:border-box;transform:scale(.98);transform-origin:center}
.emotion-time{font-size:22rpx;color:rgba(38,35,31,.45)}
.emotion-media{margin-top:22rpx;border-radius:20rpx;overflow:hidden;background:rgba(255,255,255,.6)}
.emotion-img{width:100%;height:320rpx;display:block}
.emotion-images{margin-top:22rpx;display:flex;gap:12rpx;flex-wrap:wrap}
.emotion-image{width:calc((100% - 24rpx)/3);height:170rpx;border-radius:16rpx;background:rgba(245,247,251,.92)}
.emotion-text{margin-top:18rpx;font-size:32rpx;line-height:1.85;white-space:pre-wrap}
.emotion-from{margin-top:20rpx;font-size:22rpx;color:rgba(38,35,31,.55)}
.emotion-swiper-wrap .wx-swiper-dot{width:10rpx;height:10rpx;border-radius:999rpx;background:rgba(95,125,149,.24)}
.emotion-swiper-wrap .wx-swiper-dot-active{background:rgba(95,125,149,.58)}
.today{position:relative;z-index:1;padding:34rpx 32rpx}
.today-text{font-size:26rpx;color:rgba(38,35,31,.72)}
.today-actions{margin-top:22rpx;display:flex;justify-content:flex-start}
.err{position:relative;z-index:1;margin-top:22rpx;color:#b24a4a;font-size:24rpx}

.fab{position:fixed;right:40rpx;bottom:calc(env(safe-area-inset-bottom) + 48rpx);width:112rpx;height:112rpx;border-radius:9999rpx;background:#5F7D95;z-index:100;display:flex;align-items:center;justify-content:center}
.fab-bubble{position:absolute;right:0;bottom:124rpx;padding:10rpx 14rpx;border-radius:18rpx;background:rgba(255,255,255,.78);color:rgba(38,35,31,.66);font-size:22rpx;white-space:nowrap}
.fab-icon{color:#fff;font-size:56rpx;line-height:1;font-weight:500;margin-top:-4rpx}
