<view class="page">
  <view wx:if="{{!couponGroups.length}}" class="empty">{{emptyText}}</view>

  <view wx:for="{{couponGroups}}" wx:key="key" class="card coupon">
    <view class="coupon-head">
      <view class="coupon-title-wrap">
        <view class="coupon-title">{{item.title}}</view>
        <view wx:if="{{item.count > 1}}" class="coupon-count">×{{item.count}}</view>
      </view>
      <view class="coupon-status {{item.hasUnused ? 'unused' : 'used'}}">{{item.statusText}}</view>
    </view>
    <view class="coupon-desc">{{item.desc}}</view>
    <view class="coupon-counts">已获得 {{item.totalCount}} 张 · 已使用 {{item.usedCount}} 张 · 还剩 {{item.unusedCount}} 张</view>
    <view class="coupon-time">{{item.obtainedText}}</view>

    <view wx:if="{{item.hasUnused}}" class="coupon-actions">
      <view
        class="btn-ghost {{usingGroupKey === item.key ? 'btn-disabled' : ''}}"
        data-id="{{item.nextUseId}}"
        bindtap="onMarkUsed"
        hover-class="tap-down"
        hover-stay-time="80"
      >{{markUsedText}}</view>
    </view>
  </view>
</view>
