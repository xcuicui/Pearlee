<view class="page">
  <view wx:if="{{!coupons.length}}" class="empty">{{emptyText}}</view>

  <view wx:for="{{coupons}}" wx:key="id" class="card coupon">
    <view class="coupon-head">
      <view class="coupon-title">{{item.title}}</view>
      <view class="coupon-status {{item.status === 'used' ? 'used' : 'unused'}}">{{item.statusText}}</view>
    </view>
    <view class="coupon-desc">{{item.desc}}</view>
    <view class="coupon-time">{{item.obtainedText}}</view>

    <view wx:if="{{item.canUse}}" class="coupon-actions">
      <view
        class="btn-ghost {{usingCouponId === item.id ? 'btn-disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="onMarkUsed"
        hover-class="tap-down"
        hover-stay-time="80"
      >{{markUsedText}}</view>
    </view>
  </view>
</view>
