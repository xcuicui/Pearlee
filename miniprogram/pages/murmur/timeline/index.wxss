.page {
  height: 100vh;
}

.timeline-scroll {
  height: 100vh;
}

.timeline-content {
  padding: 24rpx 32rpx 48rpx;
}

.date-group {
  margin-bottom: 18rpx;
}

.date-header {
  padding: 18rpx 6rpx 14rpx;
}

.date-text {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(38, 35, 31, 0.92);
}

.anchor-empty {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(38, 35, 31, 0.45);
  background: rgba(255, 255, 255, 0.68);
}

.entry {
  padding: 30rpx 28rpx;
  margin-bottom: 14rpx;
}

.text {
  font-size: 30rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.images {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.entry-image {
  width: calc((100% - 24rpx) / 3);
  height: 210rpx;
  border-radius: 16rpx;
  background: rgba(245, 247, 251, 0.92);
}

.meta {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time {
  font-size: 22rpx;
  color: rgba(38, 35, 31, 0.45);
}

.entry-mood {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(38, 35, 31, 0.62);
  background: rgba(255, 255, 255, 0.35);
}

.meta-stat {
  font-size: 22rpx;
  color: rgba(38, 35, 31, 0.55);
}

.loading-tip {
  padding: 16rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(38, 35, 31, 0.42);
}

.err {
  margin-top: 12rpx;
  text-align: center;
  color: #b24a4a;
  font-size: 24rpx;
}
