.grid{width:100%}
.dow{display:flex;justify-content:space-between;margin-bottom:12rpx;padding:0 8rpx}
.dow-item{width:14.28%;text-align:center;font-size:20rpx;color:rgba(38,35,31,.38)}
.cells{display:flex;flex-wrap:wrap}
.cell{width:14.28%;height:84rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;border-radius:18rpx}
.cell:active{background:rgba(255,255,255,.6)}
.is-dim{opacity:.35}
.num{font-size:24rpx;color:rgba(38,35,31,.78)}
.dot{position:absolute;bottom:10rpx;width:12rpx;height:12rpx;border-radius:999px;opacity:.9}
.dot-1{background:rgba(95,125,149,.28)}
.dot-2{background:rgba(95,125,149,.72)}
