.grid{width:100%}
.dow{display:flex;justify-content:space-between;margin-bottom:12rpx;padding:0 8rpx}
.dow-item{width:14.28%;text-align:center;font-size:20rpx;color:rgba(38,35,31,.38)}
.cells{display:flex;flex-wrap:wrap}
.cell{width:14.28%;height:84rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;border-radius:18rpx}
.cell:active{background:rgba(255,255,255,.6)}
.is-dim{opacity:.35}

/* Make marked days more noticeable, still quiet */
.has-mark::before{
  content:'';
  position:absolute;
  top:10rpx;
  left:50%;
  transform:translateX(-50%);
  width:54rpx;
  height:54rpx;
  border-radius:999px;
  background:rgba(95,125,149,.09);
}
.has-mark-2::before{ background:rgba(95,125,149,.15); }

.num{position:relative;z-index:1;font-size:24rpx;color:rgba(38,35,31,.78)}
.has-mark .num{font-weight:600;color:rgba(38,35,31,.86)}

.dot{position:absolute;bottom:10rpx;width:17rpx;height:17rpx;border-radius:999px;opacity:.92}
.dot-1{background:rgba(95,125,149,.36)}
.dot-2{width:20rpx;height:20rpx;background:rgba(95,125,149,.8)}
